# Required. Keep real credentials only in .env (ignored by Git).
DISCORD_TOKEN=
OPENAI_API_KEY=

# Automatic server moderation: enable deliberately for servers in DISCORD_GUILD_IDS.
# The existing OpenAI key scans text/image pixels; per-server policy can be changed with /action.
AUTO_MODERATION_ENABLED=false
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=12000
MODERATION_LOG_CHANNEL_ID=
# Posting in this configured channel (or its threads) triggers an automatic ban.
HONEYPOT_CHANNEL_ID=

# Display name used by the assistant persona and help. Discord profile changes are applied separately.
BOT_NAME=Vibe
# Local scheduling timezone and confirmation policy for explicit user requests.
BOT_TIME_ZONE=America/New_York
# smart executes ordinary authorized changes; privileged/destructive changes receive one preview.
CONFIRMATION_MODE=smart

# Optional: one or more comma-separated server IDs. Blank permits all installed servers.
# Existing DISCORD_BOT_TOKEN and DISCORD_GUILD_ID variables are also supported.
DISCORD_GUILD_IDS=
# Optional bot-operator user IDs for application-wide identity and inbox controls.
# The Discord application owner also has these controls.
OPERATOR_IDS=
# Trusted local code only: plugin IDs load plugins/<id>/index.js at startup.
PLUGIN_MODULES=
# Optional absolute path to a locally reviewed fixed-task JSON manifest.
LOCAL_OPERATIONS_MANIFEST=

# Enable these in the Discord Developer Portal before enabling them here.
# Members powers joins/welcome/autoroles. Message Content powers passive FAQ/spam/XP and prefix commands.
ENABLE_MEMBERS=false
ENABLE_PRESENCES=false
ENABLE_MESSAGE_CONTENT=false
ENABLE_VOICE=true
MAX_VOICE_SESSIONS=5
# Dedicated private text channel: exact ID takes precedence, otherwise discover this exact name.
VOICE_TRANSCRIPT_CHANNEL_ID=
VOICE_TRANSCRIPT_CHANNEL_NAME=vibe-transcripts
# Only name-addressed speech starts a conversation; brief relevant follow-ups can omit the name.
VOICE_REQUIRE_WAKE_WORD=true
VOICE_WAKE_WORDS=Vibe
VOICE_FOLLOW_UP_SECONDS=60
VOICE_SILENCE_MS=450
# Local Whisper checks speech before an addressed request uses OpenAI. Prepare it once per host.
# Run pnpm voice:prepare; models are cached in this project's .cache/models directory.
VOICE_TRANSCRIPTION_BACKEND=local
LOCAL_WHISPER_MODEL=Xenova/whisper-tiny.en
# Docker Compose memory limit; base.en measured about 1772 MiB process peak before bot overhead.
BOT_MEMORY_LIMIT=3072m
# openai instead uploads each consented captured utterance for transcription, including wake checks.
# Realtime renders ordinary replies as streamed Marin audio. pipeline uses text generation + TTS.
VOICE_RESPONSE_BACKEND=realtime
# Optional locally approved folder of PCM16 WAV files; Discord selects a safe filename ID only.
VOICE_AUDIO_DIRECTORY=
COMMAND_PREFIX=!

# One API key powers all configured OpenAI models. Availability and billing depend on your API account.
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_SPEECH_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Built-in OpenAI web search may have additional API charges.
ENABLE_WEB_SEARCH=false
MAX_AI_REQUESTS_PER_USER_DAY=50
MAX_AI_REQUESTS_PER_GUILD_DAY=500
MAX_AI_CONCURRENT=3
MAX_OUTPUT_TOKENS=2000
MAX_TOOL_ROUNDS=5
AI_TIMEOUT_MS=60000
MAX_ATTACHMENT_BYTES=8388608

DATABASE_PATH=data/bot.sqlite
MEMORY_DAYS=7
AUDIT_DAYS=30
CONFIRMATION_SECONDS=120
# Optional localhost health endpoint. 0 disables it. Docker sets port 3000.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0
# Signed Discord Webhook Events share the HTTP listener at /discord/events.
# Enabling this requires HEALTH_PORT and a public HTTPS reverse proxy/tunnel.
ENABLE_WEBHOOK_EVENTS=false
ENABLE_USER_INSTALL=false
# Optional companion web dashboard; shares HEALTH_PORT, uses operator-only Discord sign-in links.
ENABLE_DASHBOARD=false
# Blank uses http://127.0.0.1:<HEALTH_PORT>. Remote origins must use HTTPS.
DASHBOARD_BASE_URL=
# Optional public verification key from the Developer Portal; fetched after login if blank.
DISCORD_PUBLIC_KEY=

# Optional service integrations — blank credentials keep each service unavailable.
# Restart after changing configuration. Public services/OAuth still require their provider-side grants.

# github: GitHub fine-grained or installation token restricted to intended repositories and API permissions.
GITHUB_TOKEN=

# google: OAuth client ID; with client secret and refresh token, enables renewable Google authorization.
GOOGLE_CLIENT_ID=

# google: Google OAuth confidential client secret.
GOOGLE_CLIENT_SECRET=

# google: Authorized Google refresh token with Calendar, Sheets and/or Drive scopes.
GOOGLE_REFRESH_TOKEN=

# google: Optional short-lived access token alternative; renewable OAuth configuration is preferred.
GOOGLE_ACCESS_TOKEN=

# google: Default authorized calendar ID.
GOOGLE_CALENDAR_ID=

# gitlab: GitLab personal/project access token with the needed API scope.
GITLAB_TOKEN=

# gitlab: Trusted public HTTPS GitLab origin; no path, credentials or custom port.
GITLAB_BASE_URL=

# trello: Trello application API key.
TRELLO_API_KEY=

# trello: Trello authorized user token.
TRELLO_TOKEN=

# notion: Notion integration token; explicitly share desired pages/data sources with the integration.
NOTION_TOKEN=

# youtube: YouTube Data API v3 key with the API enabled.
YOUTUBE_API_KEY=

# twitch: Twitch application client ID.
TWITCH_CLIENT_ID=

# twitch: Twitch application secret; creates an app access token when no access token is supplied.
TWITCH_CLIENT_SECRET=

# twitch: Optional Twitch access token alternative to client-credentials acquisition.
TWITCH_ACCESS_TOKEN=

# email: Resend sending/receiving API key.
RESEND_API_KEY=

# email: Verified Resend sender address.
EMAIL_FROM=

# sms: Twilio account SID.
TWILIO_ACCOUNT_SID=

# sms: Twilio account authorization token.
TWILIO_AUTH_TOKEN=

# sms: Approved Twilio sender in E.164 format.
TWILIO_FROM=

# virustotal: VirusTotal API key; provider access/quotas apply.
VIRUSTOTAL_API_KEY=

# captcha: Public Cloudflare Turnstile site key for the companion verification page.
TURNSTILE_SITE_KEY=

# captcha: Cloudflare Turnstile Siteverify secret.
TURNSTILE_SECRET_KEY=

# captcha: Exact hostname expected in successful Turnstile verifications.
TURNSTILE_EXPECTED_HOSTNAME=

# steam: Steam Web API key for game/player statistics.
STEAM_API_KEY=

# parcels: AfterShip Tracking API key.
AFTERSHIP_API_KEY=

# commerce: Authorized Shopify shop hostname, e.g. example.myshopify.com.
SHOPIFY_SHOP=

# commerce: Shopify Admin API token with read_products and read_inventory scopes.
SHOPIFY_ADMIN_TOKEN=

# commerce: Pinned Shopify Admin API version.
SHOPIFY_API_VERSION=

# social: Trusted public HTTPS Mastodon instance origin.
MASTODON_BASE_URL=

# social: Mastodon user application token.
MASTODON_ACCESS_TOKEN=

# video-generation: Runway API organization key.
RUNWAY_API_KEY=

# video-generation: Runway model used for text/image-to-video generation.
RUNWAY_VIDEO_MODEL=

# video-processing: Shotstack Edit API key.
SHOTSTACK_API_KEY=

# video-processing: Shotstack render environment: stage or v1.
SHOTSTACK_ENVIRONMENT=

# cloud: Cloudflare API token restricted to the intended account/zone permissions.
CLOUDFLARE_API_TOKEN=

# cloud: Cloudflare account ID.
CLOUDFLARE_ACCOUNT_ID=

# oauth: Public HTTPS origin for account linking and hosted companion routes; loopback HTTP is accepted for development.
APP_PUBLIC_URL=

# oauth: Discord application ID for OAuth and Embedded App SDK.
DISCORD_CLIENT_ID=

# oauth: Discord OAuth client secret, distinct from the bot token.
DISCORD_CLIENT_SECRET=

# oauth: Optional GitHub OAuth application client ID for linked account verification.
GITHUB_OAUTH_CLIENT_ID=

# oauth: GitHub OAuth application client secret.
GITHUB_OAUTH_CLIENT_SECRET=

# oauth: Optional 32-byte base64 encryption key; a private local data key is created when omitted.
OAUTH_ENCRYPTION_KEY=

# oauth: Comma-separated operator-approved target server IDs for explicit OAuth self-join. The bot must already belong to each selected server.
OAUTH_JOIN_GUILD_IDS=

# activities: Public HTTPS origin serving the Activity; configure its URL Mapping in Discord.
ACTIVITY_PUBLIC_URL=

# game-stats: Optional project-relative JSON with operator-verified Discord/game identity mappings and typed game-stat profiles; see docs/GAME_STATS_WIDGETS.md.
GAME_STATS_PROFILES_FILE=

# premium: Optional project-relative JSON file mapping existing Discord SKUs to concrete action limits/features.
PREMIUM_POLICY_FILE=

# remote: HTTPS origin of an authorized companion host agent; loopback HTTP is accepted for local tests.
REMOTE_AGENT_URL=

# remote: Shared host-agent authorization key, at least 32 characters; never supplied through Discord commands.
REMOTE_AGENT_KEY=

# host-agent: Optional host-agent server key; blank generates data/host-agent.key locally.
HOST_AGENT_KEY=

# host-agent: Fixed local task manifest for the separate host-agent process; blank exposes authenticated status only.
HOST_AGENT_MANIFEST=

# host-agent: Optional agent bind address; default 127.0.0.1. Use an HTTPS reverse proxy for remote access.
HOST_AGENT_BIND=

# host-agent: Optional host-agent listener port; default 3010.
HOST_AGENT_PORT=

# monitor: Exact readiness URL monitored by the separate monitor process; run it on another host to detect host downtime.
MONITOR_TARGET_URL=

# monitor: Discord webhook destination for downtime/recovery alerts.
MONITOR_DISCORD_WEBHOOK_URL=

# automation-outbound: Fixed HTTPS webhook receiving explicitly configured Discord event notifications; a URL may contain a private receiver token.
OUTBOUND_AUTOMATION_URL=

# automation-outbound: HMAC secret for signed outbound automation events, at least 32 characters.
OUTBOUND_AUTOMATION_KEY=

# deployment: HMAC secret for the signed deployment-notification receiver.
DEPLOYMENT_WEBHOOK_SECRET=

# deployment: Directory containing locally reviewed built release folders with release.json manifests.
DEPLOYMENT_RELEASES_DIRECTORY=

# deployment: Supervisor release pointer file; blank disables managed releases.
DEPLOYMENT_ACTIVE_FILE=

# database: Optional PostgreSQL connection string for approved read-only named queries.
EXTERNAL_DATABASE_URL=

# database: Local JSON allowlist of named read-only parameterized SQL queries.
EXTERNAL_DATABASE_QUERIES_FILE=

# ai: Optional JSON mapping general/reasoning/code route names to permitted OpenAI models.
AI_MODEL_ROUTES_JSON=

# ai: Optional JSON mapping approved log IDs to fixed local text files; no caller-selected paths.
AI_LOG_FILES_JSON=

# voice: Optional JSON mapping approved source IDs to fixed public HTTPS audio streams. Empty disables remote stream sources.
VOICE_STREAM_SOURCES_JSON=

# plausible: Plausible Stats API key authorized for the selected site; requires a plan with Stats API access.
PLAUSIBLE_API_KEY=

# plausible: Exact website domain as registered in the authorized Plausible team.
PLAUSIBLE_SITE_ID=
